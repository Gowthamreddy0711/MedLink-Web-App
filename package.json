{
  "name": "medlink-web-app",
  "private": true,
  "version": "1.0.0",
  "homepage": "https://gowthamreddy0711.github.io/MedLink-Web-App",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml",
    "test:unit": "vitest run tests/unit/auth.test.tsx tests/unit/doctor.test.tsx tests/unit/patient.test.tsx tests/unit/appointments.test.ts --reporter=verbose",
    "test:validation": "vitest run tests/unit/validation.test.ts --reporter=verbose",
    "test:api": "vitest run tests/unit/api.test.ts --reporter=verbose",
    "test:integration": "vitest run tests/unit/integration.test.ts --reporter=verbose",
    "test:regression": "vitest run tests/unit/regression.test.ts --reporter=verbose",
    "test:security": "vitest run tests/unit/security.test.ts --reporter=verbose",
    "test:performance": "vitest run tests/unit/performance.test.ts --reporter=verbose",
    "test:accessibility": "vitest run tests/unit/accessibility.test.ts --reporter=verbose",
    "test:responsive": "vitest run tests/unit/responsive.test.ts --reporter=verbose",
    "playwright:install": "npx playwright install chromium webkit",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "qa:report": "node qa-report/generate-qa-report.js",
    "copy-404": "node scripts/copy404.js",
    "predeploy": "npm run build && npm run copy-404",
    "deploy": "gh-pages -d dist",
    "test:all": "vitest run --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml",
    "test:ci": "vitest run --coverage --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml && npm run qa:report",
    "test:security:500": "vitest run tests/unit/security-500.test.ts --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml",
    "security:report": "node scripts/generate-security-report.js",
    "test:security:all": "npm run test:security:500 && npm run security:report",
    "test:e2e:ci": "npx playwright test --config=playwright.config.ts",
    "test:qa": "npm run test:ci",
    "test:selenium": "node automation/selenium/seleniumRunner.js",
    "test:appium": "node automation/appium/appiumRunner.js",
    "test:automation:report": "node automation/reportGenerator.js",
    "test:automation": "npm run test:selenium && npm run test:appium && npm run test:automation:report"
  },
  "dependencies": {
    "@google/genai": "1.29.0",
    "@tailwindcss/vite": "4.1.14",
    "@vitejs/plugin-react": "5.0.4",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "express": "4.22.1",
    "firebase": "12.13.0",
    "lucide-react": "0.546.0",
    "motion": "12.38.0",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "react-router-dom": "7.14.2",
    "recharts": "3.8.1",
    "tailwind-merge": "3.5.0",
    "twilio": "6.0.0",
    "vite": "6.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@testing-library/dom": "^10.4.1",
    "gh-pages": "^5.0.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/express": "4.17.25",
    "@types/node": "22.14.0",
    "@vitest/coverage-v8": "2.1.8",
    "@vitest/ui": "2.1.8",
    "autoprefixer": "10.4.21",
    "axe-core": "4.10.2",
    "exceljs": "4.4.0",
    "jsdom": "25.0.1",
    "msw": "2.6.4",
    "tailwindcss": "4.1.14",
    "tsx": "4.23.1",
    "typescript": "5.8.2",
    "vitest": "2.1.8"
  },
  "overrides": {
    "node-domexception": "file:./node-domexception-mock"
  }
}
